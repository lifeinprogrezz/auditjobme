# Environment variables for auditjob.me — copy to `.env` and fill in.
# NEVER commit real secret values. This file holds placeholder NAMES only.

# ─────────────────────────────────────────────────────────────────────────────
# CLIENT (VITE_-prefixed) — inlined into the browser bundle by Vite at BUILD time.
# These are public-safe by design (anon/publishable key, project URL). They are
# NOT available in process.env at Vercel Function runtime — server code must use
# the un-prefixed vars below, never a VITE_ fallback.
# ─────────────────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_LOGODEV_TOKEN=your-logodev-publishable-token
VITE_SENTRY_DSN=your-sentry-dsn

# ─────────────────────────────────────────────────────────────────────────────
# SERVER-SIDE (Vercel Function runtime) — required by the nightly matches worker
# (api/nightly.ts). Set these in the Vercel project env (NOT VITE_-prefixed).
# Missing any of them makes the worker fail closed (500), by design.
# ─────────────────────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key   # secret — server only
CRON_SECRET=your-vercel-cron-secret                        # secret — gates the cron endpoint
RESEND_API_KEY=your-resend-api-key                         # secret — transactional email
