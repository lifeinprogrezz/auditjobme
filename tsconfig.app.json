{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    // Left off deliberately (issue #54): flags vendored shadcn/ui (calendar.tsx `_props`)
    // and a HeadBar prop — turning it on would need edits to generated components.
    "noUnusedParameters": false,
    // Left off deliberately (issue #54): allowJs pulls the legacy AuditGenerator.jsx /
    // audit *.js / scripts *.mjs into the program; checkJs surfaces 168 implicit-any
    // errors there. Typing that legacy JS is its own task, not this hardening pass.
    "checkJs": false,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2020",
    "types": [
      "vitest/globals"
    ],
    "useDefineForClassFields": true
  },
  "include": [
    "src"
  ]
}